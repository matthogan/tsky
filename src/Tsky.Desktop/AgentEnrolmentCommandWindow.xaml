<Window x:Class="tsky.AgentEnrolmentCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Enrolment"
        Width="720"
        Height="360"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppUiFontFamily}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Run this command on the remote machine" />
            <TextBlock x:Name="ExpiryTextBlock"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <TextBox x:Name="CommandTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="{DynamicResource AppMonoFontFamily}"
                 IsReadOnly="True" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="120" Height="34" Margin="0,0,8,0" Content="Copy" Click="CopyButton_Click" />
            <Button Width="100" Height="34" Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>

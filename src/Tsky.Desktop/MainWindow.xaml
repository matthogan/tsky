<Window x:Class="tsky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:tsky"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppUiFontFamily}"
        Icon="app.ico"
        Title="Task Launcher" Height="420" Width="700" MinWidth="500" MinHeight="300">
    <Window.Resources>
        <FontFamily x:Key="CardUiFontFamily">{DynamicResource AppUiFontFamily}</FontFamily>

        <Style x:Key="TaskSurfaceScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalOffset, Mode=OneWay}" />

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Orientation="Horizontal"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HorizontalOffset, Mode=OneWay}" />

                            <Border x:Name="ScrollBarCorner"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    Visibility="Collapsed" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="ComputedVerticalScrollBarVisibility" Value="Visible" />
                                    <Condition Property="ComputedHorizontalScrollBarVisibility" Value="Visible" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ScrollBarCorner" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskCardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                            CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.92" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarGroupListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SidebarGroupListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarAddTaskButtonStyle" TargetType="Button" BasedOn="{StaticResource TaskCardButtonStyle}">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,14" />
        </Style>

        <Style x:Key="SidebarGroupExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              Padding="0"
                                              Cursor="Hand"
                                              Content="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Margin="10,0,10,10"
                                                  Visibility="Collapsed"
                                                  ContentSource="Content" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarGroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupCountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1E2A35" />
            <Setter Property="BorderBrush" Value="#FF1E2A35" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="24" />
        </Style>

        <Style x:Key="GroupPreviewTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,2,2,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SidebarTreeGroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTreeExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          Cursor="Hand"
                                          Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="ExpandRegion"
                                    Background="{DynamicResource TabHeaderBackgroundBrush}"
                                    CornerRadius="0,0,6,6"
                                    Padding="0,0,0,2"
                                    Margin="0,0,0,2"
                                    Visibility="Collapsed">
                                <ContentPresenter Margin="0"
                                                  ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandRegion" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarBottomSectionStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0">
                                <ToggleButton x:Name="HeaderToggle"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="6,8"
                                              Focusable="False"
                                              Content="{TemplateBinding Header}" />
                            </Border>
                            <Border x:Name="SectionContent"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    Visibility="Collapsed"
                                    Padding="6,4,6,6">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SectionContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutputTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="OutputTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource TabHeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomPaneTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource TabHeaderBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="6,0,0,0" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent" Margin="0" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomPaneTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveIndicator"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource ConnectorFocusedBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  Margin="6,2"
                                                  VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Margin="12,2,6,2"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonSecondaryActionStyle" TargetType="Button" BasedOn="{StaticResource RibbonCommandButtonStyle}">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource TabHeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RibbonCommandHoverAccentStyle" TargetType="Button" BasedOn="{StaticResource RibbonCommandButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#27F6C0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RibbonAddCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonCommandButtonStyle}">
            <Setter Property="Foreground" Value="#FF7CFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF7CFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RibbonImportActionStyle" TargetType="Button" BasedOn="{StaticResource RibbonSecondaryActionStyle}">
            <Setter Property="Background" Value="#27F6C0" />
            <Setter Property="BorderBrush" Value="#22D6A8" />
            <Setter Property="Foreground" Value="#FF12202B" />
        </Style>

        <Style x:Key="RibbonContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                SnapsToDevicePixels="True"
                                Background="{DynamicResource PanelBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource RibbonSecondaryActionStyle}">
            <Setter Property="Background" Value="#FF22B8CF" />
            <Setter Property="BorderBrush" Value="#FF18A8BE" />
            <Setter Property="Foreground" Value="#FF12202B" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
                <Border Height="84"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0"
                    CornerRadius="10"
                    Padding="24,8,16,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.16" Color="#FF2A3440" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Image Source="app.ico"
                               Width="30"
                               Height="30"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Tsky"
                                   Margin="10,0,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RibbonAddTaskButton" Style="{StaticResource RibbonAddCommandButtonStyle}" Click="RibbonAddTaskButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RibbonAddActionLabel" Text="Add" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <Button x:Name="RibbonEditTaskButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Click="RibbonEditTaskButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RibbonEditActionLabel" Text="Edit" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RibbonToggleTaskEnabledButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Margin="8,0,0,0" Click="RibbonToggleTaskEnabledButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RibbonToggleTaskEnabledLabel" Text="Enable" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RibbonDeleteTaskButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Margin="8,0,0,0" Click="RibbonDeleteTaskButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RibbonDeleteActionLabel" Text="Delete" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                            <Button x:Name="RibbonRunChainButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Click="RibbonRunChainButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Run Chain" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RibbonGroupsDropDownButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Width="80" Margin="8,0,0,0" Click="RibbonGroupsDropDownButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Groups ▼" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <Button x:Name="RibbonHistoryButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Click="RibbonHistoryButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="History" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RibbonTaskSurfaceToggleButton" Style="{StaticResource RibbonCommandHoverAccentStyle}" Margin="8,0,0,0" Click="RibbonTaskSurfaceToggleButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RibbonTaskSurfaceToggleLabel" Text="Graph" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RibbonGatewayListenerToggleButton"
                                    Style="{StaticResource RibbonCommandHoverAccentStyle}"
                                    Margin="8,0,0,0"
                                    Click="RibbonGatewayListenerToggleButton_Click"
                                    ToolTip="Toggle local agent listener">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RibbonGatewayListenerGlyphText" Text="👂" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RibbonGatewayListenerLabel" Text="Listener" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="RibbonShareButton"
                                Style="{StaticResource RibbonSecondaryActionStyle}"
                                Click="RibbonShareButton_Click"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Share" VerticalAlignment="Center" />
                                <TextBlock Text=" &#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RibbonImportButton"
                                Style="{StaticResource RibbonImportActionStyle}"
                                Click="RibbonImportButton_Click"
                                Margin="12,0,0,0"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Import" VerticalAlignment="Center" />
                                <TextBlock Text=" &#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Menu Grid.Row="0"
                  Visibility="Collapsed"
                  Style="{StaticResource AppMenuStyle}">
                <MenuItem Header="View" Style="{StaticResource AppMenuItemStyle}">
                    <MenuItem x:Name="ViewGroupsMenuItem"
                              Header="Groups Pane"
                              IsCheckable="True"
                              Style="{StaticResource AppMenuItemStyle}"
                              Click="ViewGroupsMenuItem_Click" />
                    <Separator />
                    <MenuItem x:Name="ViewHistoryMenuItem"
                              Header="History"
                              IsCheckable="True"
                              InputGestureText="Ctrl+H"
                              Style="{StaticResource AppMenuItemStyle}"
                              Click="ViewHistoryMenuItem_Click" />
                    <MenuItem x:Name="ViewOutputMenuItem"
                              Header="Task Output"
                              IsCheckable="True"
                              InputGestureText="Ctrl+O"
                              Style="{StaticResource AppMenuItemStyle}"
                              Click="ViewOutputMenuItem_Click" />
                </MenuItem>
                <MenuItem x:Name="GroupsMenuItem" Header="Groups" Style="{StaticResource AppMenuItemStyle}" />
            </Menu>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumnDefinition" Width="220" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition x:Name="SidebarSpacerColumnDefinition" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPaneBorder"
                Grid.Column="0"
                CornerRadius="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0"
                Padding="10,10,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Expander x:Name="SidebarGroupsExpander"
                          Grid.Row="0"
                          Style="{StaticResource SidebarBottomSectionStyle}"
                          IsExpanded="True"
                          Expanded="SidebarGroupsExpander_Expanded"
                          Collapsed="SidebarGroupsExpander_Collapsed">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock x:Name="GroupsSectionChevronText"
                                       Text="▼"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="GROUPS"
                                       Foreground="{DynamicResource SidebarSectionHeaderBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GroupsHeaderCountText"
                                       DockPanel.Dock="Right"
                                       Text="(0)"
                                       Foreground="{DynamicResource ConnectorFocusedBrush}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       MinWidth="32"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>

                    <StackPanel x:Name="GroupsSectionContentPanel" Margin="0,4,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="GroupsSummaryText"
                                       Text="0 groups created"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Background="{DynamicResource TabHeaderBackgroundBrush}" CornerRadius="14" Padding="8,4" MinHeight="30">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🔍"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="GroupSearchTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                                         Padding="0"
                                         MinHeight="18"
                                         VerticalContentAlignment="Center"
                                         TextChanged="GroupSearchTextBox_TextChanged"
                                         ToolTip="File, folder or project" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <ScrollViewer x:Name="GroupsTreeScrollViewer"
                              Grid.Row="1"
                              Margin="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GroupListPanel" />
                </ScrollViewer>

                <Expander x:Name="SidebarAgentsExpander"
                          Grid.Row="2"
                          Style="{StaticResource SidebarBottomSectionStyle}"
                          IsExpanded="False"
                          Margin="0,8,0,0"
                          Expanded="SidebarAgentsExpander_Expanded"
                          Collapsed="SidebarAgentsExpander_Collapsed">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock x:Name="AgentsSectionChevronText"
                                       Text="▶"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="AGENTS"
                                       Foreground="{DynamicResource SidebarSectionHeaderBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="AgentsHeaderCountText"
                                       DockPanel.Dock="Right"
                                       Text="(0)"
                                       Foreground="{DynamicResource ConnectorFocusedBrush}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       MinWidth="32"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>

                    <StackPanel>
                        <Button x:Name="AgentsSidebarButton"
                                Padding="8,7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource SidebarTreeGroupHeaderButtonStyle}"
                                Click="AgentsSidebarButton_Click"
                                Content="Open Agents View" />

                                                <Border Background="{DynamicResource TabHeaderBackgroundBrush}" CornerRadius="14" Padding="8,4" MinHeight="30" Margin="0,4,0,4">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🔍"
                                                                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="AgentsSearchTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                         Padding="0"
                                         MinHeight="18"
                                         VerticalContentAlignment="Center"
                                         TextChanged="AgentsSearchTextBox_TextChanged"
                                         PreviewKeyDown="AgentsSearchTextBox_PreviewKeyDown"
                                         ToolTip="Search agents by name, id, or host" />
                            </DockPanel>
                        </Border>

                        <ScrollViewer x:Name="SidebarAgentsScrollViewer"
                                      Margin="0,4,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="240">
                            <StackPanel x:Name="SidebarAgentsListPanel" />
                        </ScrollViewer>
                    </StackPanel>
                </Expander>

                <Expander x:Name="SidebarSchedulerExpander"
                          Grid.Row="3"
                          Style="{StaticResource SidebarBottomSectionStyle}"
                          IsExpanded="False"
                          Margin="0,6,0,0"
                          Expanded="SidebarSchedulerExpander_Expanded"
                          Collapsed="SidebarSchedulerExpander_Collapsed">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock x:Name="SchedulerSectionChevronText"
                                       Text="▶"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE823;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="SCHEDULER"
                                       Foreground="{DynamicResource SidebarSectionHeaderBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SchedulerHeaderCountText"
                                       DockPanel.Dock="Right"
                                       Text="(0)"
                                       Foreground="{DynamicResource ConnectorFocusedBrush}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       MinWidth="32"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>

                    <StackPanel>
                        <Button x:Name="SchedulerSidebarButton"
                                Padding="8,7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource SidebarTreeGroupHeaderButtonStyle}"
                                Click="SchedulerSidebarButton_Click"
                                Content="Open Scheduler View" />
                    </StackPanel>
                </Expander>

                <Expander x:Name="SidebarTemplatesExpander"
                          Grid.Row="4"
                          Style="{StaticResource SidebarBottomSectionStyle}"
                          IsExpanded="False"
                          Margin="0,6,0,0"
                          Expanded="SidebarTemplatesExpander_Expanded"
                          Collapsed="SidebarTemplatesExpander_Collapsed">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock x:Name="TemplatesSectionChevronText"
                                       Text="▶"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="TASK TEMPLATES"
                                       Foreground="{DynamicResource SidebarSectionHeaderBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TemplatesHeaderCountText"
                                       DockPanel.Dock="Right"
                                       Text="(0)"
                                       Foreground="{DynamicResource ConnectorFocusedBrush}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       MinWidth="32"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>

                    <StackPanel>
                        <Button x:Name="TemplatesSidebarButton"
                                Padding="8,7"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource SidebarTreeGroupHeaderButtonStyle}"
                                Click="TemplatesSidebarButton_Click"
                                Content="Open Task Templates View" />
                    </StackPanel>
                </Expander>

            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                  Width="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition x:Name="OutputRowDefinition" Height="220" MinHeight="120" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
                <TextBlock x:Name="GroupTitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Text="Group" />
                <TextBlock x:Name="GroupMetaText"
                           Margin="0,2,0,0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Replay snapshots are available from each task menu." />
                <TextBlock x:Name="EmptyStateText"
                           Margin="0,4,0,0"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <ScrollViewer
                    x:Name="TaskScrollViewer"
                    Style="{StaticResource TaskSurfaceScrollViewerStyle}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <Grid x:Name="TaskWorkspaceSurface">
                        <WrapPanel x:Name="TaskPanel" HorizontalAlignment="Center" />
                        <Canvas x:Name="TaskGraphEdgeOverlay"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Panel.ZIndex="12" />
                        <Canvas x:Name="TaskGraphCanvas"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Cursor="Hand"
                            IsHitTestVisible="True"
                            Panel.ZIndex="14" />
                        <Canvas x:Name="TaskConnectorOverlay"
                            IsHitTestVisible="True"
                                Panel.ZIndex="20" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <GridSplitter x:Name="OutputGridSplitter"
                Grid.Row="2"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent"
                Cursor="SizeNS"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <Grid x:Name="OutputContainer" Grid.Row="3" Margin="0,0,0,0">
                <TabControl x:Name="BottomPaneTabControl"
                            Style="{StaticResource BottomPaneTabControlStyle}"
                            ItemContainerStyle="{StaticResource BottomPaneTabItemStyle}"
                            SelectionChanged="BottomPaneTabControl_SelectionChanged">
                    <TabItem x:Name="OutputPaneTabItem" Header="Task Output">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Grid x:Name="OutputTabHost"
                                  Background="{DynamicResource PanelBackgroundBrush}" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="HistoryPaneTabItem" Header="History">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border x:Name="HistoryPanelBorder"
                                    Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="History"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                            <Button x:Name="ToggleHistoryDetailsButton"
                                                Content="Hide Details"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="ToggleHistoryDetailsButton_Click" />
                                            <Button x:Name="ReplaySelectedButton"
                                                    Content="Replay Selected"
                                                    Style="{StaticResource HistoryActionButtonStyle}"
                                                    Click="ReplaySelectedButton_Click" />
                                            <Button x:Name="ClearHistorySelectionButton"
                                                    Content="Clear"
                                                    Margin="0"
                                                    Style="{StaticResource HistoryActionButtonStyle}"
                                                    Click="ClearHistorySelectionButton_Click" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="HistoryListRow" Height="2*" />
                                            <RowDefinition x:Name="HistoryDetailsGapRow" Height="6" />
                                            <RowDefinition x:Name="HistoryDetailsRow" Height="3*" />
                                        </Grid.RowDefinitions>

                                        <ListBox x:Name="HistoryListBox"
                                                 Grid.Row="0"
                                                 SelectionMode="Extended"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 SelectionChanged="HistoryListBox_SelectionChanged" />

                                        <GridSplitter Grid.Row="1"
                                                      Height="6"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      Background="{DynamicResource SplitterBrush}"
                                                      ResizeDirection="Rows"
                                                      ResizeBehavior="PreviousAndNext"
                                                      ShowsPreview="True" />

                                        <Border x:Name="HistoryDetailsBorder"
                                            Grid.Row="2"
                                                Background="#1A000000"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Details"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,6" />

                                                <TextBox x:Name="HistoryDetailsTextBox"
                                                         Grid.Row="1"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         Background="#00000000"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         FontFamily="{DynamicResource AppMonoFontFamily}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="AgentRuntimePaneTabItem" Header="Agent Runtime" Visibility="Collapsed">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Agent Runtime"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <TextBlock x:Name="AgentRuntimeTitleText"
                                               Grid.Row="1"
                                               Text="Select an agent"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />

                                    <TextBlock x:Name="AgentRuntimeMetaText"
                                               Grid.Row="2"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,10" />

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Active runs" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,8" />
                                        <TextBlock x:Name="AgentRuntimeActiveRunsText" Grid.Row="0" Grid.Column="1" Text="-" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Session" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,8" />
                                        <TextBlock x:Name="AgentRuntimeSessionText" Grid.Row="1" Grid.Column="1" Text="-" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Connectivity" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,8" />
                                        <TextBlock x:Name="AgentRuntimeConnectivityText" Grid.Row="2" Grid.Column="1" Text="-" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Successful runs" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,8" />
                                        <TextBlock x:Name="AgentRuntimeSuccessfulText" Grid.Row="3" Grid.Column="1" Text="Not currently tracked" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Failed runs" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" />
                                        <TextBlock x:Name="AgentRuntimeFailedText" Grid.Row="4" Grid.Column="1" Text="Not currently tracked" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="GatewaySettingsPaneTabItem" Header="Gateway Settings" Visibility="Collapsed">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.ColumnSpan="2"
                                               Text="Desktop Gateway"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <TextBlock x:Name="GatewaySettingsSummaryText"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,6" />

                                    <CheckBox x:Name="GatewayEnableTlsCheckBox"
                                               Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Content="Enable HTTPS listener (TLS)"
                                               FontSize="11"
                                               Checked="GatewaySettingsToggleChanged"
                                               Unchecked="GatewaySettingsToggleChanged"
                                               Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="Host"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="0,0,8,8" />
                                    <TextBox x:Name="GatewayHostTextBox"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Height="30"
                                               TextChanged="GatewaySettingsTextChanged"
                                               Margin="0,0,0,8"
                                               Background="{DynamicResource PanelBackgroundBrush}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               BorderBrush="{DynamicResource PanelBorderBrush}" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="Port"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="0,0,8,8" />
                                    <TextBox x:Name="GatewayPortTextBox"
                                             Grid.Row="4"
                                             Grid.Column="1"
                                             Height="30"
                                             TextChanged="GatewaySettingsTextChanged"
                                             Margin="0,0,0,8"
                                             Background="{DynamicResource PanelBackgroundBrush}"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderBrush="{DynamicResource PanelBorderBrush}" />

                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               Text="PFX certificate"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="0,0,8,8" />
                                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="GatewayCertPathTextBox"
                                                 Grid.Column="0"
                                                 Height="30"
                                                 TextChanged="GatewaySettingsTextChanged"
                                                 Background="{DynamicResource PanelBackgroundBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource PanelBorderBrush}" />

                                        <Button x:Name="GatewayBrowseCertButton"
                                                Grid.Column="1"
                                                Content="Browse..."
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Margin="8,0,0,0"
                                                Click="GatewayBrowseCertButton_Click" />
                                    </Grid>

                                    <TextBlock Grid.Row="6"
                                               Grid.Column="0"
                                               Text="PFX password"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="0,0,8,8" />
                                    <PasswordBox x:Name="GatewayCertPasswordBox"
                                                 Grid.Row="6"
                                                 Grid.Column="1"
                                                 Height="30"
                                                 Padding="8,0,8,0"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="GatewaySettingsPasswordChanged"
                                                 Margin="0,0,0,8"
                                                 Background="{DynamicResource PanelBackgroundBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource PanelBorderBrush}" />

                                    <CheckBox x:Name="GatewayDevFallbackCheckBox"
                                              Grid.Row="7"
                                              Grid.ColumnSpan="2"
                                              Content="Allow localhost HTTP fallback for development"
                                              FontSize="11"
                                              Checked="GatewaySettingsToggleChanged"
                                              Unchecked="GatewaySettingsToggleChanged"
                                              Margin="0,0,0,8" />

                                    <TextBlock x:Name="GatewaySettingsStatusText"
                                               Grid.Row="8"
                                               Grid.ColumnSpan="2"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <Grid Grid.Row="9" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="GatewaySettingsValidationText"
                                                   Grid.Column="0"
                                                   Text=""
                                                   FontSize="11"
                                                   Foreground="#FFE16A6A"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                        <Button x:Name="ApplyGatewaySettingsFromTabButton"
                                                Grid.Column="1"
                                                Content="Save and Apply"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Margin="0"
                                                MinWidth="128"
                                                IsEnabled="False"
                                                Click="ApplyGatewaySettingsFromTabButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="InputPortsPaneTabItem" Header="Input Ports">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="InputPortsEditorTitleText"
                                               Text="Input Ports"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Input Name" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="Default Value" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="Binding (Optional)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Text="Binding format: port:OutputName or TaskName.OutputName"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,8" />

                                    <ScrollViewer Grid.Row="3"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="InputPortsRowsPanel" />
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button x:Name="AddInputPortRowButton"
                                                Content="+ Add Input"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="AddInputPortRowButton_Click" />
                                        <Button x:Name="SaveInputPortsButton"
                                                Content="Save Inputs"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="SaveInputPortsButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="OutputPortsPaneTabItem" Header="Output Ports">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="OutputPortsEditorTitleText"
                                               Text="Output Ports"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Output Name" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="Output Value" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="OutputPortsRowsPanel" />
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button x:Name="AddOutputPortRowButton"
                                                Content="+ Add Output"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="AddOutputPortRowButton_Click" />
                                        <Button x:Name="SaveOutputPortsButton"
                                                Content="Save Outputs"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="SaveOutputPortsButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="VariablesPaneTabItem" Header="Variables">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="VariablesEditorTitleText"
                                               Text="Variables"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Variable Name" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="Variable Value" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="VariablesRowsPanel" />
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button x:Name="AddVariableRowButton"
                                                Content="+ Add Variable"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="AddVariableRowButton_Click" />
                                        <Button x:Name="SaveVariablesButton"
                                                Content="Save Variables"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="SaveVariablesButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ResultEvaluatorPaneTabItem" Header="Result Evaluator">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="ResultEvaluatorTitleText"
                                               Text="Result Evaluator"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                    <TextBlock x:Name="ResultEvaluatorStatusText"
                                               Grid.Row="1"
                                               Text="Optional JavaScript function evaluate(task) returning { outcome: 'success' | 'failure', message?, reasonCode? }."
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <avalonedit:TextEditor x:Name="ResultEvaluatorScriptTextBox"
                                                           Grid.Row="2"
                                                           FontFamily="{DynamicResource AppMonoFontFamily}"
                                                           MinHeight="140"
                                                           Margin="0,0,0,12" />

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,8,0,0">
                                        <Button x:Name="SaveResultEvaluatorButton"
                                                Content="Save Evaluator"
                                                Style="{StaticResource HistoryActionButtonStyle}"
                                                Click="SaveResultEvaluatorButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="AgentsDispatchPaneTabItem"
                             Header="Agents"
                             Visibility="Collapsed"
                             AutomationProperties.Name="Agents Dispatch Tab"
                             AutomationProperties.HelpText="Run the currently selected task on a specific online agent.">
                        <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="8,8,8,8">
                            <Border Padding="10"
                                    CornerRadius="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="AgentsDispatchTitleText"
                                               Text="Run Selected Task On Agent"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"
                                               AutomationProperties.Name="Agents Dispatch Title" />

                                    <TextBlock x:Name="AgentsDispatchValidationText"
                                               Grid.Row="1"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               AutomationProperties.Name="Agents Dispatch Status Message"
                                               AutomationProperties.HelpText="Validation and dispatch guidance for agent runs." />

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.Name="Agents Dispatch Rows">
                                        <StackPanel x:Name="AgentsDispatchRowsPanel"
                                                    AutomationProperties.Name="Agent Dispatch Row List" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>

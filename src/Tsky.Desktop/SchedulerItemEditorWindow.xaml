<Window x:Class="tsky.SchedulerItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Item"
        Width="560"
        MinWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppUiFontFamily}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource TabHeaderSelectedBackgroundBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DialogTitleTextBlock"
                   Grid.Row="0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text="Schedule item" />

        <TextBlock x:Name="TargetSummaryTextBlock"
                   Grid.Row="1"
                   Margin="0,6,0,10"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2" Text="Display Name" Margin="0,0,0,4" />
        <TextBox x:Name="DisplayNameTextBox"
                 Grid.Row="3"
                 MinHeight="34"
                 Padding="8,6"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}" />

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Local Date" Margin="0,0,0,4" />
                <DatePicker x:Name="TriggerDatePicker" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Local Time (HH:mm)" Margin="0,0,0,4" />
                <TextBox x:Name="TriggerTimeTextBox" MinHeight="30" Padding="6,4" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Run Window (seconds)" Margin="0,0,0,4" />
                <TextBox x:Name="TriggerWindowSecondsTextBox" MinHeight="30" Padding="6,4" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="RecurringCheckBox"
                  Grid.Row="5"
                  Margin="0,10,0,0"
                  Content="Repeatable schedule"
                  Checked="RecurringCheckBox_Changed"
                  Unchecked="RecurringCheckBox_Changed" />

        <StackPanel Grid.Row="6" Margin="24,6,0,0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Text="Every" Margin="0,0,8,0" />
            <TextBox x:Name="RecurrenceMinutesTextBox" Width="90" MinHeight="30" Padding="6,4" />
            <TextBlock VerticalAlignment="Center" Text="minute(s)" Margin="8,0,0,0" />
        </StackPanel>

        <CheckBox x:Name="EnabledCheckBox"
                  Grid.Row="7"
                  Margin="0,10,0,0"
                  Content="Enabled" />

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="8"
                   Margin="0,8,0,0"
                   Foreground="#FFE57373"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="9"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="Cancel"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="CancelButton_Click" />
            <Button Width="110"
                    Height="34"
                    Content="Save"
                    Style="{StaticResource PrimaryDialogButtonStyle}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="tsky.AgentDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent"
        Width="620"
        MinWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppUiFontFamily}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text="Agent definition" />

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,12" MinHeight="34" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="State" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <ComboBox x:Name="StateComboBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,12" MinHeight="34" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Controller URL" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="ControllerUrlTextBox" Grid.Row="3" Grid.Column="0" Margin="0,4,0,12" MinHeight="34" />

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Max runs" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="MaximumRunsTextBox" Grid.Row="3" Grid.Column="2" Margin="0,4,0,12" MinHeight="34" />

            <CheckBox x:Name="RequiresApprovalCheckBox"
                      Grid.Row="4"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="Require approval after enrolment request"
                      Margin="0,2,0,0" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Description" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="DescriptionTextBox"
                     Grid.Row="1"
                     Margin="0,4,0,12"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="2" Text="Allowed executors" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="AllowedExecutorsTextBox"
                     Grid.Row="3"
                     Margin="0,4,0,0"
                     MinHeight="34"
                     ToolTip="Comma-separated executor identifiers, for example process.v1" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationTextBlock"
                       DockPanel.Dock="Left"
                       Foreground="#FFE57373"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="RegenerateTokenCheckBox"
                          Content="Generate enrolment token"
                          Margin="0,0,18,0"
                          VerticalAlignment="Center" />
                <Button Width="100"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Click="CancelButton_Click" />
                <Button Width="100"
                        Height="34"
                        Content="Save"
                        Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
